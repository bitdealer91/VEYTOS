# Network for server jobs. Must agree with NEXT_PUBLIC_APTOS_NETWORK.
APTOS_NETWORK=testnet
# Exposed to browsers. Only devnet/testnet/mainnet are accepted.
NEXT_PUBLIC_APTOS_NETWORK=testnet
# Leave unset until real package publication; no default contract address.
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
# Deployment transaction version; needed for complete indexing, not guessed.
LAUNCHPAD_DEPLOYMENT_VERSION=
# Optional server-only endpoint overrides and API key. Never prefix secret keys NEXT_PUBLIC_.
APTOS_FULLNODE_URL=
APTOS_INDEXER_URL=
APTOS_API_KEY=
# Public origin binds wallet authentication, links and social metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only PostgreSQL DSN. Fill locally; do not commit credentials.
DATABASE_URL=
# Server-only IPFS-compatible HTTP service and credential; implementation pending.
IPFS_API_URL=
IPFS_API_TOKEN=
# Public retrieval gateway; CIDs remain stored as ipfs:// references.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Optional public identifier, not an Aptos signing key.
NEXT_PUBLIC_APTOS_CONNECT_DAPP_ID=
# Path to an installed Aptos CLI binary (default: aptos in PATH).
APTOS_CLI=aptos
# Operator-only: absolute path to disposable testnet account JSON OUTSIDE this repo.
# Example location: ~/.local/share/mintos/testnet/accounts.json (expand ~ yourself).
# File must have 0600 permissions. Never put keys or seed phrases in .env.
MINTOS_TESTNET_ACCOUNTS_FILE=
