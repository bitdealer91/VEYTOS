# Public network and server network must agree. Never use mainnet funds for acceptance.
APTOS_NETWORK=testnet
NEXT_PUBLIC_APTOS_NETWORK=testnet
# Optional public/browser RPC override. Do not put a secret API key in NEXT_PUBLIC_*.
# NEXT_PUBLIC_APTOS_FULLNODE_URL=https://your-public-aptos-rpc.example/v1
# Server scripts may use a private managed endpoint and key without exposing them to the browser.
APTOS_FULLNODE_URL=
APTOS_API_KEY=
# Published Gate A package; public address, not a private key. Build-time browser config.
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x5e802dc2d3105fbf967541d9cd64f5d34a18ebb473a4d40ddb26c8f727e9db28
# Phase 2B V1/V2 marketplace package. Public address, never a signing key.
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x40fcdc2583e3e15c09f20a5d777b72f7bec8a9ac9292d57c03e9fb23c091eebb
MARKETPLACE_ADDRESS=0x40fcdc2583e3e15c09f20a5d777b72f7bec8a9ac9292d57c03e9fb23c091eebb
VEYTOS_V2_REVIEWED_COLLECTION=0x287dea5ae1c96817a211877faf19b38d1884fb4a59305101db44fc32fb609e61
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HTTPS metadata gateway. Canonical on-chain ipfs:// URIs remain unchanged.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Server-only discovery seeds: comma-separated drop authority addresses, maximum 20.
# These select real chain resources, not fabricated collection records.
VEYTOS_DISCOVERY_DROPS=0xa9ff8a00fda26cbb50c1b32ac198fe8f1c8128587f7ec822a9202cd2c8600e3
# Optional known mint hashes for the read layer; there is no activity page yet.
VEYTOS_ACTIVITY_TXS=
VEYTOS_MARKETPLACE_TXS=
# No signing keys, seed phrases, wallet profiles or storage secrets belong here.
